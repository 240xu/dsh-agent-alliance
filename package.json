{
  "name": "dsh-agent-alliance",
  "version": "0.2.0",
  "description": "External-agent extension for DeepSeek Harness: dispatch to Claude Code / Codex / OpenCode / ZCode CLIs, hold roundtables, browse their histories and import them as resumable DSH sessions. Delegation inside DSH is owned by the official subagent / subagent_fork tools.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale",
    "icon.svg",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/240xu/dsh-agent-alliance.git"
  },
  "bugs": {
    "url": "https://github.com/240xu/dsh-agent-alliance/issues"
  },
  "homepage": "https://github.com/240xu/dsh-agent-alliance#readme"
}
